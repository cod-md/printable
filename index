 claude.use('permissions').then(p=>{if(p&&!row.querySelector('.pm')){const b=document.createElement('button');b.className='g pm';b.textContent='Permissions';b.style.marginLeft='6px';b.onclick=()=>p.manage().catch(()=>{});row.append(b)}}).catch(()=>{})}
async function show(outs){
