  const s=document.createElement('span');s.innerHTML=`<b></b><br><small></small>`;s.firstChild.textContent=f.label;s.lastChild.textContent=f.name+' · '+(f.data.length/1048576).toFixed(2)+' MB';
  const b=document.createElement('button');b.textContent='Download';
  b.onclick=async()=>{
   const blob=new Blob([f.data],{type:'application/pdf'});
   let d=null;try{d=await claude.use('downloads')}catch(e){}
   if(d){try{await d.save({filename:f.name,data:blob});st('Saved ✓');return}catch(e){if(e&&e.code==='declined')return;st('Save failed ('+(e&&e.code||e)+'). Trying fallback…')}}
   fallback(r,blob,f.name)};
  r.append(s,b);o.append(r)})}

/* ===== shuffle + multi-file question bank ===== */
function shuffleSep(arr,kf){const a=arr.slice();for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}
 for(let i=1;i<a.length;i++){if(kf(a[i])===kf(a[i-1])){const j=a.findIndex((x,k)=>k>i&&kf(x)!==kf(a[i-1])&&(i+1>=a.length||kf(x)!==kf(a[i+1])||true));if(j>0)[a[i],a[j]]=[a[j],a[i]]}}return a}
const CUE=/\b(important|key|main|essential|critical|remember|note|must|always|never|significant|defined?|summary|conclusion|principle|rule|law|theorem|formula)\b/gi;
function gScore(g,df){const all=g.sents.concat(g.lists.flatMap(l=>l.items)),txt=all.join(' ');let sc=Math.min(8,g.words/10);
 if(g.sents.some(x=>RX.def.test(x)))sc+=3;if(g.sents.some(x=>RX.cmp.test(x)))sc+=2;if(g.sents.some(x=>RX.proc.test(x)))sc+=2;if(g.sents.some(x=>RX.cause.test(x)))sc+=2;if(g.lists.some(l=>l.items.length>=3))sc+=1;
 sc+=2*Math.min(3,(txt.match(CUE)||[]).length);
 const ws=[...new Set((txt.match(/\b[A-Za-z]{5,}\b/g)||[]).map(w=>w.toLowerCase()).filter(w=>!STOP.has(w)))];sc+=Math.min(5,ws.filter(w=>df[w]>=2).length*.5);
 if(/^(agenda|outline|contents|objectives?|references|thank|questions|overview|learning outcomes)/i.test(g.title))sc-=6;return sc}
async function runMulti(){
 const N=Math.max(5,+$('n2').value||30),docs=[];
 for(let i=0;i<files2.length;i++){st('Reading file '+(i+1)+'/'+files2.length+'…');const pg=await extractText(files2[i].bytes),a=analyse(pg);docs.push({name:files2[i].name.replace(/\.pdf$/i,''),a,gr:a.groups})}
 if(!docs.some(d=>d.gr.length))throw new Error('No readable text found in these files.');
 const df={};docs.forEach(d=>{const set=new Set();d.gr.forEach(g=>(g.sents.concat(g.lists.flatMap(l=>l.items)).join(' ').match(/\b[A-Za-z]{5,}\b/g)||[]).forEach(w=>set.add(w.toLowerCase())));set.forEach(w=>df[w]=(df[w]||0)+1)});
 docs.forEach(d=>{d.qs=makeQs(d.gr);d.sc=d.gr.map(g=>gScore(g,df))});
 const tot=docs.reduce((n,d)=>n+d.sc.reduce((a,b)=>a+Math.max(0,b),0),0)||1;let picks=[];
 docs.forEach((d,fi)=>{const fs=d.sc.reduce((a,b)=>a+Math.max(0,b),0),quota=Math.max(1,Math.round(N*fs/tot));
  d.sc.map((v,gi)=>({v,gi})).sort((x,y)=>y.v-x.v).slice(0,quota).forEach(({v,gi})=>{const l=d.qs.filter(q=>q.g===gi),q=l.find(x=>x.spec)||l[0];if(q)picks.push({v,f:fi,q:q.q,a:q.a,ref:d.name+' - '+q.ref})})});
 picks=picks.sort((x,y)=>y.v-x.v).slice(0,N);
 const qs=shuffleSep(picks,x=>x.f);
 st('Building question bank…');
 const data=await qbPdf(qs,{pages:docs.reduce((n,d)=>n+d.a.pages,0)},'Combined question bank ('+docs.length+' files)');
 MSTAT=qs.length+' high-yield questions from '+docs.length+' file(s), shuffled.';
 return[{name:'Question_Bank_combined.pdf',label:'Combined question bank ('+qs.length+' questions)',data}]}
