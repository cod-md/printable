function fallback(row,blob,name){
 const u=URL.createObjectURL(blob);
 if(!row.querySelector('.fb')){const a=document.createElement('a');a.className='btn g fb';a.href=u;a.download=name;a.target='_blank';a.textContent='Open / save PDF';a.style.marginLeft='6px';row.append(a)}
